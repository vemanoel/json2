{
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "mise",
        "args": ["exec", "--", "nu"]
      }
    }
  },
  "lsp": {
    "gopls": {
      "binary": {
        "path": "mise",
        "arguments": ["exec", "--", "gopls"]
      },
      "initialization_options": {
        "gofumpt": false,
        "staticcheck": true,
        "analyses": {
          "ST1000": false,
          "ST1003": false,
          "newexpr": false,
          "shift": true,
          "nilness": true,
          "useany": true,
          "shadow": true,
          "unusedparams": true,
          "unusedwrite": true,
          "unusedvariable": true,
          "slicesdelete": true
        }
      }
    }
  },
  "languages": {
    "Go": {
      "format_on_save": "on"
    },
    "JSONC": {
      "format_on_save": "off"
    }
  }
}
